              "formdata": [
                {
                  "key": "knowledge_base_name",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) Name of the knowledge base. Must be less than 40 characters."
                },
                {
                  "key": "knowledge_base_texts",
                  "value": "[{\"title\":\"<string>\",\"text\":\"<string>\"},{\"title\":\"<string>\",\"text\":\"<string>\"}]",
