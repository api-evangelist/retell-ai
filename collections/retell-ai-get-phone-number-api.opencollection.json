{
  "opencollection": "1.0.0",
  "info": {
    "name": "Retell SDK Add Community Voice Get Phone Number API",
    "version": "3.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Get Phone Number",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "getPhoneNumber",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.retellai.com/get-phone-number/:phone_number",
            "params": [
              {
                "name": "phone_number",
                "value": "",
                "type": "path",
                "description": "E.164 format of the number (+country code, then number with no space, no special characters), used as the unique identifier for phone number APIs."
              }
            ]
          },
          "docs": "Retrieve details of a specific phone number"
        }
      ]
    }
  ],
  "bundled": true
}